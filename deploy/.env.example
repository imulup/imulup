# Copy to deploy/.env and fill in. deploy/.env is gitignored; never commit it.

# --- GitHub authentication: use EITHER a GitHub App OR a token ---
# Leave the other option's lines commented out: an empty value still counts as set.

# Option A (recommended): GitHub App. Put the app's private key at deploy/github-app.pem
# (gitignored) and `chmod 600` it; compose mounts it as /run/secrets/gh_app_key.
IMULUP_GH_APP_ID=
IMULUP_GH_APP_KEY_FILE=/run/secrets/gh_app_key

# Option B: token for a bot account: needs repo contents (read), pull requests, issues
# (comments), and commit statuses. Also comment out the `secrets:` lines in compose.yaml.
# IMULUP_GH_TOKEN=
# Login of the account that owns IMULUP_GH_TOKEN (its own comments are ignored)
# IMULUP_GH_USER=

# --- GitHub webhook ---
# Same secret as configured on the GitHub webhook (generate with: openssl rand -hex 32)
IMULUP_GH_WEBHOOK_SECRET=
# Repos imulup may act on, comma-separated globs, e.g. my-org/infra-test
IMULUP_REPO_ALLOWLIST=

# --- Behaviour (optional) ---
# IMULUP_REQUIRE_APPROVAL=true
# IMULUP_REQUIRE_MERGEABLE=true
# IMULUP_PLAN_DRAFTS=false
# IMULUP_STEP_TIMEOUT_SECS=3600
# Merge PRs once every planned project is applied. A GitHub App needs Contents: Read & write.
# IMULUP_AUTOMERGE=true
# IMULUP_AUTOMERGE_METHOD=merge   # merge | squash | rebase

# --- Pulumi ---
# Pulumi Cloud backend token (or set PULUMI_BACKEND_URL for a self-managed backend)
PULUMI_ACCESS_TOKEN=
# PULUMI_BACKEND_URL=s3://my-state-bucket
# PULUMI_CONFIG_PASSPHRASE=

# --- Cloud credentials your Pulumi programs need, e.g. AWS ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- Host port to publish (default 4141) ---
# IMULUP_PUBLISH_PORT=4141
